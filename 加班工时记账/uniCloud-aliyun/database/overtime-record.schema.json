{
  "bsonType": "object",
  "required": ["user_id", "date", "overtime_type"],
  "permission": {
    "read": "auth.uid == doc.user_id",
    "create": "auth.uid != null",
    "update": "auth.uid == doc.user_id",
    "delete": "auth.uid == doc.user_id"
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "记录ID，自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "关联 uni-id-users._id",
      "forceDefaultValue": {
        "$env": "uid"
      }
    },
    "date": {
      "bsonType": "string",
      "description": "加班日期 YYYY-MM-DD",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "start_time": {
      "bsonType": "string",
      "description": "开始时间 HH:MM（时薪模式必填）",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "end_time": {
      "bsonType": "string",
      "description": "结束时间 HH:MM（时薪模式必填）",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "duration": {
      "bsonType": "number",
      "description": "加班时长（小时），如 3.5",
      "minimum": 0,
      "maximum": 24
    },
    "overtime_type": {
      "bsonType": "string",
      "description": "加班类型",
      "enum": ["weekday", "weekend", "holiday"]
    },
    "pay_mode": {
      "bsonType": "string",
      "description": "计薪方式",
      "enum": ["hourly", "daily", "piece"],
      "defaultValue": "hourly"
    },
    "rate": {
      "bsonType": "number",
      "description": "时薪（元/小时），时薪模式使用",
      "minimum": 0
    },
    "daily_rate": {
      "bsonType": "number",
      "description": "日薪标准（元/天），日薪模式使用",
      "minimum": 0
    },
    "piece_rate": {
      "bsonType": "number",
      "description": "单件工资（元），计件模式使用",
      "minimum": 0
    },
    "piece_unit": {
      "bsonType": "string",
      "description": "计件单位，如 件/个/套",
      "maxLength": 10
    },
    "days": {
      "bsonType": "number",
      "description": "加班天数（日薪模式）",
      "minimum": 0
    },
    "quantity": {
      "bsonType": "number",
      "description": "完成件数（计件模式）",
      "minimum": 0
    },
    "pay": {
      "bsonType": "number",
      "description": "预估加班费",
      "minimum": 0
    },
    "net_pay": {
      "bsonType": "number",
      "description": "净额 = 加班费 + 补贴 - 扣款",
      "minimum": 0
    },
    "remark": {
      "bsonType": "string",
      "description": "备注（选填）",
      "maxLength": 200
    },
    "photos": {
      "bsonType": "array",
      "description": "照片云存储 URL 列表",
      "maxLength": 3,
      "items": {
        "bsonType": "string"
      }
    },
    "settled": {
      "bsonType": "bool",
      "description": "是否已结算",
      "defaultValue": false
    },
    "subsidies": {
      "bsonType": "object",
      "description": "补贴明细",
      "properties": {
        "night_shift": { "bsonType": "number", "description": "夜班补贴" },
        "meal": { "bsonType": "number", "description": "餐补" },
        "transport": { "bsonType": "number", "description": "交通补贴" }
      }
    },
    "deduction": {
      "bsonType": "object",
      "description": "扣款明细",
      "properties": {
        "amount": { "bsonType": "number", "description": "扣款金额" },
        "note": { "bsonType": "string", "description": "扣款原因" }
      }
    },
    "project_name": {
      "bsonType": "string",
      "description": "所属项目名称",
      "maxLength": 50
    },
    "project_id": {
      "bsonType": "string",
      "description": "关联 project-config._id"
    },
    "device_id": {
      "bsonType": "string",
      "description": "匿名设备标识，未登录时使用"
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
